{
  "id": "./",
  "name": "Whiskerfield — A Little World, All Yours",
  "short_name": "Whiskerfield",
  "description": "A small open-world game where you are a cat. Climb roofs, meet the neighbours, find shinies, knock things over. Works offline.",
  "start_url": "./?launch=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#f7f1e3",
  "theme_color": "#f7f1e3",
  "lang": "en",
  "categories": [
    "games",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://cid0980.github.io/Whiskerfield/manifest.webmanifest"
    }
  ]
}
